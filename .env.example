# Caddy site address. Keep :80 before a domain exists; later replace it with the DNS name.
SITE_ADDRESS=:80

# Backend concurrency and per-process GDAL block cache (MiB).
UVICORN_WORKERS=2
GDAL_CACHEMAX=256

# Reject larger raster windows before reading data.
MAX_AREA_QUERY_PIXELS=4000000

# Keep interactive API documentation disabled in production.
ENABLE_API_DOCS=false

# Same-origin production traffic needs no CORS entry. Use comma-separated origins for development.
CORS_ORIGINS=

# Host-relative runtime paths used by local development and the preflight command.
# Docker Compose overrides these with the corresponding /app paths.
RASTER_ROOT=data/rasters
IRRIGATION_ANNUAL_ROOT=data/rasters/irrigation_annual
IRRIGATION_8DAY_ROOT=data/rasters/irrigation_8day
IRRIGATION_ANNUAL_COG_ROOT=data/rasters/irrigation_annual
IRRIGATION_8DAY_COG_ROOT=data/rasters/irrigation_8day

# Generated runtime statistics and separately uploaded administrative vectors.
IRRIGATION_RUNTIME_STATS_ROOT=data/stats/irrigation_runtime
COUNTY_VECTOR_PATH=data/vectors/irrigation/county/china_county.shp
TOWNSHIP_CHUNK_ROOT=data/vectors/irrigation/township_by_county

# Writable named-volume path for generated caches.
CACHE_ROOT=.runtime-cache
