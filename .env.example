# Caddy site address. Keep :80 before a domain exists; later replace it with the DNS name.
SITE_ADDRESS=:80

# Backend concurrency and per-process GDAL block cache (MiB).
UVICORN_WORKERS=1
GDAL_CACHEMAX=256

# Reject larger raster windows before reading data.
MAX_AREA_QUERY_PIXELS=4000000

# Keep interactive API documentation disabled in production.
ENABLE_API_DOCS=false

# Same-origin production traffic needs no CORS entry. Use comma-separated origins for development.
CORS_ORIGINS=

# Runtime raster roots inside the backend container.
RASTER_ROOT=/app/data/rasters
IRRIGATION_ANNUAL_ROOT=/app/data/rasters/irrigation_annual
IRRIGATION_8DAY_ROOT=/app/data/rasters/irrigation_8day
IRRIGATION_ANNUAL_COG_ROOT=/app/data/rasters/irrigation_annual
IRRIGATION_8DAY_COG_ROOT=/app/data/rasters/irrigation_8day

# Separately uploaded statistics and administrative-vector files.
IRRIGATION_REGION_SERIES_PATH=/app/runtime-data/stats/irrigation_region_series.json
COUNTY_VECTOR_PATH=/app/data/vectors/irrigation/county/china_county.shp
TOWNSHIP_CHUNK_ROOT=/app/data/vectors/irrigation/township_by_county

# Writable named-volume path for generated caches.
CACHE_ROOT=/app/cache
