# ===== 遥感数据展示平台 — 环境变量配置 =====
# 复制此文件为 .env 并根据实际部署环境修改

# ---- CORS 白名单（逗号分隔）----
# 开发环境: http://localhost:5173
# 生产环境: https://your-domain.com 或 http://<服务器IP>
CORS_ORIGINS=http://localhost

# ---- 灌溉数据源路径（仅用于扫描可用时间列表）----
# 源栅格目录（非 COG），用于发现可用的时间点
IRRIGATION_ANNUAL_ROOT=/app/data/rasters/irrigation_annual
IRRIGATION_8DAY_ROOT=/app/data/rasters/irrigation_8day

# ---- COG 瓦片数据路径 ----
# 默认值指向项目内 data/rasters/ 下的 COG 文件
IRRIGATION_ANNUAL_COG_ROOT=/app/data/rasters/irrigation_annual
IRRIGATION_8DAY_COG_ROOT=/app/data/rasters/irrigation_8day

# ---- GDAL 性能调优 ----
# GDAL 块缓存大小，单位 MB（根据服务器内存调整）
GDAL_CACHEMAX=512
